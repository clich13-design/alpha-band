@startuml
|Toi|
start
:Ouvrir PR\n(code ou doc);

|OpenCode|
if (Type = code ?) then (oui)
  :Review mécanique\n(tests, lint, build);
  :Poser commentaires;
else (non)
endif

|Hermes|
if (Type = doc ?) then (oui)
  :Review cohérence\n(vault, plan, MoSCoW);
  :Poser commentaires;
else (non)
endif

|Toi|
:Lire les reviews;
:Demander changements\nou Approuver;

if (Approuvé ?) then (oui)
  :Squash-merge\nsur main;
  if (PR validation\nde phase ?) then (oui)
    :Tag manuel\n(vX-phase);
  else (non)
  endif
  stop
else (non)
  :Itérer sur branche\néphémère;
  |OpenCode|
  if (Code) then (oui)
    :Re-review OpenCode;
  else (non)
  endif
  |Hermes|
  if (Doc) then (oui)
    :Re-review Hermes;
  else (non)
  endif
  |Toi|
  :Re-approuver;
  stop
@enduml
